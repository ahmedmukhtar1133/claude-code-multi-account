{
  "name": "claude-code-multi-account",
  "displayName": "Claude Code Multi-Account: Shared History",
  "description": "A different Claude account in each VS Code window, with one shared history, memory, skills and settings. Unofficial, not affiliated with Anthropic. Never reads login data, makes no network calls.",
  "version": "0.1.0",
  "publisher": "deskworthy",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedmukhtar1133/claude-code-multi-account"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude-code",
    "multiple accounts",
    "multi-account",
    "account switcher",
    "shared history",
    "CLAUDE_CONFIG_DIR"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeMultiAccount",
          "title": "Claude Code Multi-Account",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "claudeMultiAccount": [
        {
          "type": "webview",
          "id": "claudeMultiAccount.panel",
          "name": "Claude Code Multi-Account"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeMultiAccount.switch",
        "title": "Switch account",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.addAccount",
        "title": "Add account",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.adoptFolder",
        "title": "Adopt an existing config folder",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.undoAdoption",
        "title": "Undo an adoption",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.repair",
        "title": "Repair links",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.doctor",
        "title": "Doctor",
        "category": "Claude Multi-Account"
      },
      {
        "command": "claudeMultiAccount.syncMcp",
        "title": "Copy MCP servers between accounts",
        "category": "Claude Multi-Account"
      }
    ],
    "configuration": {
      "title": "Claude Code Multi-Account",
      "properties": {
        "claudeMultiAccount.accounts": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "Accounts. `folder` is relative to your home folder, so the same list works on every machine. Leave `folder` out (or `null`) for the default account, which uses `~/.claude` and is also where shared data lives.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in the status bar."
              },
              "folder": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Config folder relative to home, for example .claude-work. Null for the default account."
              }
            }
          }
        },
        "claudeMultiAccount.defaultAccount": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Account used by windows that have no account chosen yet. Empty means the default account (~/.claude)."
        },
        "claudeMultiAccount.unsharedProjects": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Project folders (absolute or `~/...`) whose Claude history stays separate in each non-default account, for example client repos under NDA. Empty means everything is shared."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.4.0"
  }
}
